// use prisma-8

enum RoleScopeType {
  @@type("pg/text@1")

  Global   = "global"
  Location = "location"
}

enum PermissionScopePolicy {
  @@type("pg/text@1")

  GlobalOnly       = "global_only"
  LocationOrGlobal = "location_or_global"
}

model Role {
  id          BigInt        @id @default(autoincrement())
  name        VarChar(120)
  systemKey VarChar(80)? @unique @map("system_key")
  scopeType   RoleScopeType @map("scope_type")
  isProtected Boolean       @default(false) @map("is_protected")
  description VarChar(500)?
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")

  rolePermissions RolePermission[]

  @@unique([name, scopeType])
  @@unique([id, scopeType])
  @@map("roles")
}

model Permission {
  id          BigInt                @id @default(autoincrement())
  code        VarChar(100)          @unique
  scopePolicy PermissionScopePolicy @map("scope_policy")
  description VarChar(500)?
  createdAt   TimestamptzString     @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")
  createdAt   TimestamptzString @default(now()) @map("created_at")

  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}